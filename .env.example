# CARENEST - Production & Local Configuration
# Intelligent Elderly Care & Family Coordination Platform

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# PostgreSQL connection string with pooling or direct access
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db"

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
# NextAuth / JWT secret for cookie encryption & AES-256-GCM 2FA secret encryption (32+ chars random string)
NEXTAUTH_SECRET="carenest-hackathon-production-jwt-encryption-key-2026-secure"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------------
# Google OAuth 2.0 Sign-In (Optional / Ready for Production)
# -------------------------------------------------------------
# To enable Google Single Sign-On for Family Administrators & Caretakers:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorized JavaScript Origins:
#    - http://localhost:3000
#    - https://your-production-domain.com
# 4. Add Authorized Redirect URIs:
#    - http://localhost:3000/api/auth/callback/google
#    - https://your-production-domain.com/api/auth/callback/google
# 5. Paste the generated Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# -------------------------------------------------------------
# Real Email Delivery Infrastructure
# Configure either Option A (SMTP / Gmail) OR Option B (Resend API)
# -------------------------------------------------------------

# OPTION A: Universal SMTP / Gmail (Recommended for Real Inboxes with Zero DNS Setup)
# To use a personal or workspace Gmail account:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other" -> Name: "CareNest")
# 3. Enter your Gmail address and the 16-character App Password below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="CareNest Health <your-email@gmail.com>"
EMAIL_FROM="CareNest Health <your-email@gmail.com>"

# OPTION B: Resend HTTP API (For Verified Custom Domains)
# 1. Sign up at https://resend.com and create an API key
# 2. If using 'onboarding@resend.dev', Resend ONLY permits delivering to the single email address registered on Resend.
# 3. To deliver to any arbitrary Gmail address, you must verify your custom domain in Resend DNS.
# RESEND_API_KEY="re_123456789..."
# EMAIL_FROM="CareNest Health <notifications@yourverifieddomain.com>"

# -------------------------------------------------------------
# Server-side Scheduler & Escalation Cron Security
# -------------------------------------------------------------
# Secret token required to trigger the Cloud Scheduler endpoint:
# POST /api/scheduler/process-escalations
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-long-random-string"

# -------------------------------------------------------------
# Caretaker Verification & Secure Document Storage
# -------------------------------------------------------------
# File storage adapter: 'local' (default disk storage) or 's3' (AWS S3, Cloudflare R2, Supabase Storage)
FILE_STORAGE_ADAPTER="local"

# S3 Configuration (Required only when FILE_STORAGE_ADAPTER="s3")
# S3_BUCKET="carenest-clinical-documents"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com" # Optional: for Cloudflare R2 / MinIO
# S3_ACCESS_KEY_ID="your-s3-access-key-id"
# S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# Automated Verification Development Sandbox
# Set to 'true' only in local development to enable deterministic registry responses for TEST-* numbers:
# TEST-OK*, TEST-EXPIRED*, TEST-REVOKED*, TEST-MISMATCH*, TEST-NOTFOUND*, TEST-SLOW*
# Note: The system will refuse to start if this flag is enabled when NODE_ENV="production".
VERIFICATION_DEV_SANDBOX="false"

# -------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------
NODE_ENV="development"
