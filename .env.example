# CARENEST - Production & Local Configuration
# Intelligent Elderly Care & Family Coordination Platform

# -------------------------------------------------------------
# Database Configuration
# -------------------------------------------------------------
# PostgreSQL connection string with pooling or direct access
# Example: postgresql://postgres:postgres@localhost:5432/carenest_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db"

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
# NextAuth / JWT secret for cookie encryption (32+ chars random string)
NEXTAUTH_SECRET="carenest-hackathon-production-jwt-encryption-key-2026-secure"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------------
# Transactional Email Infrastructure (Resend Provider)
# -------------------------------------------------------------
# Set your Resend API key for proactive email delivery:
# - Medication reminder emails
# - Missed-dose alert emails
# - Caregiver escalation emails
# - Appointment reminders
# If left empty or omitted, CareNest automatically operates in development
# mock/fallback mode, logging email previews to the console and audit logs
# without failing the application.
RESEND_API_KEY=""
EMAIL_FROM="CareNest Notifications <notifications@carenest.health>"

# -------------------------------------------------------------
# Server-side Scheduler & Escalation Cron Security
# -------------------------------------------------------------
# Secret token required to trigger the Cloud Scheduler endpoint:
# POST /api/scheduler/process-escalations
# Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="carenest-scheduler-secret-escalation-token-2026"

# -------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------
NODE_ENV="development"
