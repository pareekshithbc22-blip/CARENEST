generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SENIOR
  FAMILY
  CARETAKER
  ADMIN
}

enum CircleRole {
  ADMIN
  FAMILY_MEMBER
  CARETAKER
  SENIOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DoseStatus {
  SCHEDULED
  TAKEN
  MISSED
  SKIPPED
  UNCONFIRMED
}

enum ScheduleFrequency {
  DAILY
  SPECIFIC_DAYS
  AS_NEEDED
  WEEKLY
}

enum MedicationForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  DROPS
  INHALER
  TOPICAL
  OTHER
}

enum AppointmentStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NoteCategory {
  GENERAL
  OBSERVATION
  MOOD
  HEALTH_UPDATE
  HANDOVER
  INCIDENT
}

enum NotificationType {
  MEDICATION_REMINDER
  MISSED_DOSE_ALERT
  ESCALATION_WARNING
  APPOINTMENT_REMINDER
  CARE_TASK_ASSIGNED
  REFILL_ALERT
  SYSTEM
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  AUTO_APPROVED
  AUTO_REJECTED
  EXPIRED
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  CANCELLED
}

model User {
  id                      String         @id @default(uuid())
  email                   String         @unique
  name                    String
  passwordHash            String?
  googleId                String?        @unique
  role                    UserRole       @default(FAMILY)
  phoneNumber             String?
  avatarUrl               String?
  isEmailVerified         Boolean        @default(false)
  emailVerified           DateTime?
  isActive                Boolean        @default(true)
  twoFactorEnabled        Boolean        @default(false)
  twoFactorSecret         String?        // AES-256-GCM encrypted Base32 secret
  twoFactorRecoveryCodes  String[]       @default([]) // SHA-256 hashed recovery codes
  twoFactorPendingSecret  String?        // Temporary AES-256-GCM secret during setup
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // Relationships
  circleMemberships CareCircleMember[]
  createdCircles    CareCircle[]       @relation("CreatedCircles")
  sentInvitations   CareCircleInvitation[] @relation("SentInvitations")
  elderlyProfilesCreated ElderlyProfile[] @relation("CreatedProfiles")
  confirmedDoses    ScheduledDose[]    @relation("ConfirmedBy")
  assignedTasks     CareTask[]         @relation("AssignedTo")
  completedTasks    CareTask[]         @relation("CompletedBy")
  authoredNotes     CareNote[]         @relation("AuthoredNotes")
  handoverNotesReceived CareNote[]     @relation("HandoverTo")
  createdAppointments Appointment[]    @relation("CreatedAppointments")
  notifications     Notification[]
  notificationPref  NotificationPreference?
  auditLogs         AuditLog[]
  caretakerProfile  CaretakerProfile?      @relation("CaretakerVerificationProfile")
  reviewedCaretakers CaretakerProfile[]    @relation("ReviewedByAdmin")
  caretakerAccessRequests PatientAccessRequest[] @relation("CaretakerAccessRequests")
  familyAdminAccessRequests PatientAccessRequest[] @relation("FamilyAdminAccessRequests")
  assignedMedications Medication[]       @relation("AssignedMedications")
  requestActions    PatientAccessRequest[] @relation("RequestActionByUser")
  stockUpdates      Medication[]           @relation("StockUpdatedBy")
  tasksAssigned     CareTask[]             @relation("TasksAssignedBy")
  taskCompletions   DailyTaskCompletion[]  @relation("CompletedTaskCompletions")
  unreadMarkers     UnreadMarker[]
  sessions          UserSession[]

  @@index([email])
}

model ElderlyProfile {
  id                    String         @id @default(uuid())
  name                  String
  preferredName         String?
  dateOfBirth           DateTime
  gender                String?
  bloodGroup            String?
  allergies             String[]       @default([])
  medicalConditions     String[]       @default([])
  emergencyContactName  String
  emergencyContactPhone String
  emergencyContactRelation String?
  notes                 String?
  avatarUrl             String?
  patientCode           String?        @unique
  declinedCaretakerIds  String[]       @default([])
  assignmentStatus      String         @default("UNASSIGNED") // "AWAITING_APPROVAL", "ASSIGNED", "UNASSIGNED"
  isSeniorModeActive    Boolean        @default(false)
  seniorPin             String?        // Hashed 4-digit PIN for rapid simplified senior check-in
  timeZone              String         @default("Asia/Kolkata")
  createdById           String
  createdBy             User           @relation("CreatedProfiles", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  careCircles           CareCircle[]
  medications           Medication[]
  scheduledDoses        ScheduledDose[]
  appointments          Appointment[]
  careTasks             CareTask[]
  careNotes             CareNote[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  caretakerAccessRequests PatientAccessRequest[]
  unreadMarkers         UnreadMarker[]

  @@index([createdById])
  @@index([patientCode])
}

model CareCircle {
  id                String                 @id @default(uuid())
  name              String
  elderlyProfileId  String
  elderlyProfile    ElderlyProfile         @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User                   @relation("CreatedCircles", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  members           CareCircleMember[]
  invitations       CareCircleInvitation[]
  auditLogs         AuditLog[]

  @@index([elderlyProfileId])
  @@index([createdById])
}

model CareCircleMember {
  id            String       @id @default(uuid())
  careCircleId  String
  careCircle    CareCircle   @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CircleRole   @default(FAMILY_MEMBER)
  permissions   String[]     @default(["CAN_VIEW_RECORDS", "CAN_CONFIRM_DOSE"])
  isActive      Boolean      @default(true)
  joinedAt      DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([careCircleId, userId])
  @@index([careCircleId])
  @@index([userId])
  @@index([userId, isActive])
}

model CareCircleInvitation {
  id            String           @id @default(uuid())
  careCircleId  String
  careCircle    CareCircle       @relation(fields: [careCircleId], references: [id], onDelete: Cascade)
  email         String
  role          CircleRole       @default(FAMILY_MEMBER)
  token         String           @unique
  status        InvitationStatus @default(PENDING)
  invitedById   String
  invitedBy     User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([token])
  @@index([email])
  @@index([careCircleId])
}

model Medication {
  id                    String                @id @default(uuid())
  elderlyProfileId      String
  elderlyProfile        ElderlyProfile        @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  name                  String
  brandName             String?
  genericName           String?
  form                  MedicationForm        @default(TABLET)
  strength              String                // e.g. "500 mg", "10 ml"
  dosageInstructions    String                // e.g. "Take 1 tablet after food with water"
  prescribingDoctor     String?
  prescribingClinic     String?
  rxNumber              String?
  purpose               String?               // e.g. "Hypertension", "Type 2 Diabetes"
  isArchived            Boolean               @default(false)
  discontinuedReason    String?
  assignedById          String?
  assignedBy            User?                 @relation("AssignedMedications", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt            DateTime?
  strengthNumber        Float?
  strengthUnit          String?               // mg, mcg, ml
  durationDays          Int?
  startDate             DateTime?
  endDate               DateTime?
  reason                String?
  stockCount            Float?
  stockUpdatedAt        DateTime?
  stockUpdatedById      String?
  stockUpdatedBy        User?                 @relation("StockUpdatedBy", fields: [stockUpdatedById], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  schedules             MedicationSchedule[]
  scheduledDoses        ScheduledDose[]
  stock                 MedicationStock?

  @@index([elderlyProfileId])
  @@index([isArchived])
}

model MedicationSchedule {
  id                  String             @id @default(uuid())
  medicationId        String
  medication          Medication         @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  frequency           ScheduleFrequency  @default(DAILY)
  timesOfDay          String[]           // e.g. ["08:00", "20:00"]
  daysOfWeek          Int[]              @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sunday
  startDate           DateTime           @default(now())
  endDate             DateTime?
  dosageQuantity      Float              @default(1.0)
  instructions        String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  scheduledDoses      ScheduledDose[]

  @@index([medicationId])
}

model ScheduledDose {
  id                    String             @id @default(uuid())
  medicationId          String
  medication            Medication         @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduleId            String?
  schedule              MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  elderlyProfileId      String
  elderlyProfile        ElderlyProfile     @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  scheduledAt           DateTime
  status                DoseStatus         @default(SCHEDULED)
  confirmedAt           DateTime?
  confirmedById         String?
  confirmedBy           User?              @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmationNotes     String?
  takenBy               String?            // "patient" | "caretaker"
  gracePeriodMinutes    Int                @default(45)
  escalationLevel       Int                @default(0) // 0: None, 1: Caretaker notified, 2: Family escalation
  escalatedAt           DateTime?
  idempotencyKey        String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([elderlyProfileId, scheduledAt])
  @@index([elderlyProfileId, scheduledAt, status])
  @@index([status, scheduledAt])
  @@index([medicationId])
}

model MedicationStock {
  id                  String       @id @default(uuid())
  medicationId        String       @unique
  medication          Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  currentStock        Float        @default(0)
  unit                String       @default("tablets") // tablets, capsules, ml, sprays
  refillThreshold     Float        @default(10)
  packageSize         Float?
  lastRefillDate      DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([medicationId])
}

model Appointment {
  id                    String             @id @default(uuid())
  elderlyProfileId      String
  elderlyProfile        ElderlyProfile     @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  title                 String
  doctorName            String
  specialty             String?
  clinicName            String
  locationAddress       String?
  appointmentDate       DateTime
  status                AppointmentStatus  @default(UPCOMING)
  reminderMinutesBefore Int                @default(1440) // 24 hours
  reminderSent          Boolean            @default(false)
  notes                 String?
  outcomeSummary        String?
  createdById           String
  createdBy             User               @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([elderlyProfileId, appointmentDate])
  @@index([status])
}

model CareTask {
  id                String         @id @default(uuid())
  elderlyProfileId  String
  elderlyProfile    ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        User?          @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById      String?
  assignedBy        User?          @relation("TasksAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  taskType          String?        // WALKING_EXERCISE, SLEEP, BLOOD_SUGAR_CHECK, BLOOD_PRESSURE_CHECK, HYDRATION, MEALS_DIET, CUSTOM
  details           Json?
  startDate         DateTime?
  endDate           DateTime?
  untilStopped      Boolean        @default(false)
  timesOfDay        String[]       @default([])
  stoppedAt         DateTime?
  title             String
  description       String?
  dueDate           DateTime
  priority          TaskPriority   @default(MEDIUM)
  status            TaskStatus     @default(PENDING)
  completedAt       DateTime?
  completedById     String?
  completedBy       User?          @relation("CompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  notes             String?
  completions       DailyTaskCompletion[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([elderlyProfileId, dueDate])
  @@index([assignedToId, status])
}

model CareNote {
  id                  String         @id @default(uuid())
  elderlyProfileId    String
  elderlyProfile      ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  authorId            String
  author              User           @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)
  category            NoteCategory   @default(GENERAL)
  title               String
  content             String
  vitalSigns          Json?          // { bp: "120/80", pulse: 72, sugar: 110, temp: 98.6 }
  condition           String?        // STABLE, IMPROVING, NEEDS_ATTENTION, CRITICAL
  observations        String?
  appetite            String?
  mood                String?
  sleepQuality        String?
  painLevel           Int?
  mobility            String?
  isPinned            Boolean        @default(false)
  shiftHandoverToId   String?
  shiftHandoverTo     User?          @relation("HandoverTo", fields: [shiftHandoverToId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([elderlyProfileId, createdAt])
  @@index([elderlyProfileId, category, createdAt])
  @@index([category])
}

model Notification {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  elderlyProfileId  String?
  elderlyProfile    ElderlyProfile?  @relation(fields: [elderlyProfileId], references: [id], onDelete: SetNull)
  type              NotificationType
  title             String
  message           String
  data              Json?
  isRead            Boolean          @default(false)
  readAt            DateTime?
  dedupKey          String?          @unique
  deliveryStatus    String           @default("SENT") // SENT, FAILED
  emailSent         Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailReminders        Boolean  @default(true)
  missedDoseAlerts      Boolean  @default(true)
  escalationAlerts      Boolean  @default(true)
  appointmentReminders  Boolean  @default(true)
  dailySummaryEmail     Boolean  @default(false)
  gracePeriodMinutes    Int      @default(45)
  updatedAt             DateTime @updatedAt
}

model AuditLog {
  id                String          @id @default(uuid())
  elderlyProfileId  String?
  elderlyProfile    ElderlyProfile? @relation(fields: [elderlyProfileId], references: [id], onDelete: SetNull)
  careCircleId      String?
  careCircle        CareCircle?     @relation(fields: [careCircleId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action            String          // e.g. DOSE_CONFIRMED, MEDICATION_CREATED, ACCESS_REVOKED
  entityType        String          // Dose, Medication, CareCircle, Member
  entityId          String?
  details           Json?
  ipAddress         String?
  createdAt         DateTime        @default(now())

  @@index([elderlyProfileId, createdAt])
  @@index([action])
}

model EmailVerificationOtp {
  id          String   @id @default(uuid())
  email       String   @unique
  hashedOtp   String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model CaretakerProfile {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation("CaretakerVerificationProfile", fields: [userId], references: [id], onDelete: Cascade)
  fullName             String             // Full legal name
  professionalCategory String             // e.g. "Registered Nurse (RN)", "Doctor / Physician Assistant", "Certified Caregiver"
  qualification        String             // e.g. "B.Sc Nursing", "GNM", "Diploma in Geriatric Care"
  specialization       String?            // e.g. "Geriatric Care", "Post-operative Care"
  yearsOfExperience    Int?
  backgroundSummary    String?
  registrationNumber   String?            // Certificate / license number
  issuingAuthority     String             // e.g. "State Nursing Council", "Medical Council", "Red Cross"
  state                String?            // State / Region
  documentFileName     String             // Original filename
  documentFilePath     String             // Secure storage path (not publicly served)
  documentMimeType     String             // application/pdf, image/jpeg, image/png
  documentFileSize     Int                // Size in bytes
  status               VerificationStatus @default(PENDING)
  rejectionReason      String?
  reviewedById         String?
  reviewedBy           User?              @relation("ReviewedByAdmin", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  verificationCases    VerificationCase[]

  @@index([status])
  @@index([userId])
}

model PatientAccessRequest {
  id               String              @id @default(uuid())
  elderlyProfileId String
  elderlyProfile   ElderlyProfile      @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  caretakerId      String
  caretaker        User                @relation("CaretakerAccessRequests", fields: [caretakerId], references: [id], onDelete: Cascade)
  familyAdminId    String
  familyAdmin      User                @relation("FamilyAdminAccessRequests", fields: [familyAdminId], references: [id], onDelete: Cascade)
  status           AccessRequestStatus @default(PENDING)
  notes            String?             // Message from caretaker
  rejectionReason  String?             // Reason if rejected
  actionByUserId   String?
  actionByUser     User?               @relation("RequestActionByUser", fields: [actionByUserId], references: [id], onDelete: SetNull)
  actionAt         DateTime?
  requestedAt      DateTime            @default(now())
  respondedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([elderlyProfileId, caretakerId])
  @@index([elderlyProfileId])
  @@index([caretakerId])
  @@index([caretakerId, status])
  @@index([familyAdminId])
  @@index([familyAdminId, status])
  @@index([status])
}

model PatientCodeCounter {
  id        String   @id @default("singleton")
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DailyTaskCompletion {
  id                String         @id @default(uuid())
  taskId            String
  task              CareTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  localDate         String         // YYYY-MM-DD
  completedAt       DateTime       @default(now())
  completedByUserId String
  completedByUser   User           @relation("CompletedTaskCompletions", fields: [completedByUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())

  @@unique([taskId, localDate])
  @@index([taskId])
  @@index([localDate])
  @@index([taskId, localDate])
}

model UnreadMarker {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  elderlyProfileId String
  elderlyProfile   ElderlyProfile @relation(fields: [elderlyProfileId], references: [id], onDelete: Cascade)
  tab              String         // "tasks" | "medications" | "notes"
  lastSeenAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, elderlyProfileId, tab])
  @@index([userId, elderlyProfileId])
}

enum VerificationCaseStatus {
  SUBMITTED
  PROCESSING
  AUTO_APPROVED
  AUTO_REJECTED
  MANUAL_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum VerificationDecisionSource {
  SYSTEM
  ADMIN
}

enum VerificationStage {
  FILE_CHECKS
  EXTRACTION
  RISK_CHECKS
  REGISTRY_LOOKUP
  IDENTITY_BINDING
  DECISION
  NOTIFICATIONS
}

enum VerificationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model VerificationCase {
  id                  String                     @id @default(uuid())
  caretakerProfileId  String
  caretakerProfile    CaretakerProfile           @relation(fields: [caretakerProfileId], references: [id], onDelete: Cascade)
  status              VerificationCaseStatus     @default(SUBMITTED)
  decisionSource      VerificationDecisionSource @default(SYSTEM)
  reasonCodes         String[]                   @default([])
  scores              Json?
  attempts            Int                        @default(0)
  documentHash        String?                    // SHA-256 of uploaded file
  normalizedRegNumber String?
  normalizedAuthority String?
  submittedAt         DateTime                   @default(now())
  decidedAt           DateTime?
  validUntil          DateTime?
  nextReverifyAt      DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  jobs   VerificationJob[]
  events VerificationEvent[]

  @@index([caretakerProfileId])
  @@index([status])
  @@index([documentHash])
  @@index([normalizedRegNumber, normalizedAuthority])
}

model VerificationJob {
  id            String                @id @default(uuid())
  caseId        String
  case          VerificationCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage         VerificationStage
  status        VerificationJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(3)
  nextAttemptAt DateTime              @default(now())
  lockedAt      DateTime?
  lastErrorCode String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([caseId])
}

model VerificationEvent {
  id          String           @id @default(uuid())
  caseId      String
  case        VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage       String
  providerId  String?
  outcome     String
  reasonCodes String[]         @default([])
  timestamp   DateTime         @default(now())
  actor       String           // "SYSTEM" or Admin User ID
  details     Json?

  @@index([caseId, timestamp])
}

model UserSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId           String    @unique
  twoFactorVerified Boolean   @default(false)
  verifiedAt        DateTime?
  lastActiveAt      DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([tokenId])
}

model RateLimitBucket {
  id             String    @id @default(uuid())
  key            String    @unique
  action         String
  identifier     String
  attempts       Int       @default(1)
  firstAttemptAt DateTime  @default(now())
  lastAttemptAt  DateTime  @default(now())
  lockedUntil    DateTime?
  blockedCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([key])
  @@index([action, identifier])
  @@index([lockedUntil])
}



